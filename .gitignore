# Dependencies
node_modules/

# Env / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
.next/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Prisma
backend/prisma/*.db

# User-uploaded files (local disk storage for this prototype)
backend/uploads/

# Python recommendation service (Phase 6): virtualenv, bytecode, caches, downloaded model files
recommendation-service/.venv/
recommendation-service/.env
recommendation-service/model-cache/
__pycache__/
*.pyc
.pytest_cache/

# Test coverage and browser-test screenshots
coverage/
frontend/e2e/shots/

# Design canvas: generated/seeded output (regenerate from design/wireframes/*.dc.html + canvas.json);
# the .dc.html source files and canvas.json themselves ARE tracked.
design/wireframes/zyro-wireframes.html

# Redis snapshots and append-only files, written wherever redis-server is started from (the
# portable Redis in tools/redis has no configured dir). Never part of the project.
*.rdb
*.aof
appendonlydir/

# Private uploads (receipts, voice notes) on the local storage driver. Never served statically.
backend/uploads-private/

# azd keeps each environment's settings, including secrets, in .azure/<environment>/. Only the
# deployment plan is part of the project.
.azure/*
!.azure/deployment-plan.md
