# Zyro recommendation service (Python/FastAPI). It reads the process environment only (it does not
# load a .env file itself); see README.md for a start command that sets these.
#
# Legend: [required] will not start without it   [optional] safe default   [secret] never commit or log

# [required][secret] Shared token the backend sends as X-Internal-Token. Must equal
# RECOMMENDATION_SERVICE_TOKEN in the backend's environment.
RECOMMENDATION_SERVICE_TOKEN="replace-with-a-long-random-string"

# [required][secret] The same MongoDB the backend uses (the database name in the URI is the one read).
MONGODB_URI="mongodb://localhost:27017/zyro"

# [optional] fastembed (default, a real local model) | hashing (deterministic, no download; tests only).
# RECO_EMBEDDER="fastembed"
# RECO_MODEL="BAAI/bge-small-en-v1.5"
# [optional] Where model files are cached (default: the OS temp folder, which can be cleared).
# RECO_MODEL_CACHE="model-cache"
# [optional] Weakest similarity a free-text search may return (tuned for the model above).
# RECO_SEARCH_MIN_SCORE=0.55

# [optional] Voice notes: local speech to text. Off unless true (the production image includes it).
# WHISPER_ENABLED=false
# WHISPER_MODEL="small"
