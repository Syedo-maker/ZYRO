# The service reads these from the process environment (it does not load a .env file itself);
# see README.md for a start command that sets them.

# Shared secret Node sends as X-Internal-Token. Required: the service refuses to start without it.
# Must equal RECOMMENDATION_SERVICE_TOKEN in backend/.env.
RECOMMENDATION_SERVICE_TOKEN="replace-with-a-long-random-string"

# The same MongoDB the backend uses. The database name in the URI is the one that is read.
MONGODB_URI="mongodb://localhost:27017/zyro"

# "fastembed" (default, a real local model) or "hashing" (deterministic, no download; tests only).
# RECO_EMBEDDER="fastembed"
# RECO_MODEL="BAAI/bge-small-en-v1.5"
# Where the model files are cached. Default is the OS temp folder, which can be cleared: set this
# to a permanent folder in real use.
# RECO_MODEL_CACHE="model-cache"
# Weakest similarity a free-text search may return (the assistant's semantic search). The default
# is tuned for the model above; another model needs its own value.
# RECO_SEARCH_MIN_SCORE=0.55
