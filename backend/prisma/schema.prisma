// ShopMind AI: PostgreSQL schema (Prisma)
// Phase 0, Module 1: Database schema design
// Entities per Implementation_Plan.md Section 1 (Relational store) and Phase 1/2/3/4/5 module specs.
//
// Multi-tenancy model: shared database, shared schema. Every tenant-scoped table carries
// a `tenantId` column. Isolation is enforced in two layers (see documentation/Phase0_Module1_Database_Schema_Design.md):
//   1. Prisma middleware (application layer): auto-injects tenantId on every query.
//   2. PostgreSQL Row-Level Security (database layer): see prisma/manual-sql/001_enable_rls.sql.
//      (Kept outside prisma/migrations/, since Prisma's migrate engine treats every subfolder
//      there as a real migration and errors on anything that isn't one.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────

enum StaffPermission {
  PRODUCTS_WRITE
  ORDERS_WRITE
  DISCOUNTS_WRITE
  ANALYTICS_READ
  POS_SELL
  INVENTORY_WRITE
  REFUNDS
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

/// A store's subscription plan (Part A, revenue model). What each tier includes lives in
/// src/lib/plans.ts, not here, so limits and prices can change without a migration.
enum PlanTier {
  FREE
  PRO
  BUSINESS
}

/// Which sales channel created an order. Both channels share one order, inventory and
/// payment model; only the workflow in front of it differs.
enum SalesChannel {
  ONLINE
  POS
}

enum PaymentMethod {
  CASH
  CARD
  STRIPE
  OTHER
  /// Part E: the shopper pays the courier in cash on delivery. The payment row exists from the
  /// moment the order does, but stays PENDING until the merchant records the cash as collected.
  COD
  /// Part E: the shopper transfers the money themselves (bank or wallet) and uploads a screenshot.
  BANK_TRANSFER
  /// Part E: a local gateway (JazzCash, Easypaisa, ...) through the adapter in modules/payments.
  GATEWAY
}

enum StockMovementType {
  INITIAL
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
}

enum CheckoutSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  REFUNDED
  FAILED
}

/// PAID: online order paid, awaiting fulfilment. COMPLETED: in-store sale, paid and handed over.
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CartRecoveryStatus {
  SENT
  OPENED
  CLICKED
  CONVERTED
}

// ──────────────────────────────────────────────────────────────────────────
// IDENTITY & TENANCY
// ──────────────────────────────────────────────────────────────────────────

/// A single login-capable account. Covers both merchant owners/staff and customers:
/// a customer is simply a User with no Tenant ownership and no StaffMember rows.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownedTenants     Tenant[]       @relation("TenantOwner")
  staffMemberOf    StaffMember[]
  refreshTokens    RefreshToken[]
  customerProfiles Customer[]
  cashierOrders    Order[]        @relation("OrderCashier")

  @@index([email])
}

/// Server-side record of issued refresh tokens, keyed by a hash (never the raw token).
/// Without this, logout cannot actually revoke a token before its natural expiry; a
/// stateless JWT alone has no way to be invalidated early. Added during Phase 1 Module 1
/// implementation; not present in the original Module 1 schema pass.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A merchant's store. The tenant-isolation boundary for every scoped table below.
model Tenant {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?
  themeColor            String?
  ownerId               String
  currency              String   @default("USD")
  /// Percentage, e.g. 8.25 for 8.25%. Prices are treated as tax-exclusive.
  taxRate               Decimal  @default(0) @db.Decimal(5, 2)
  /// Last order number issued for this tenant; incremented atomically inside createOrder.
  orderCounter          Int      @default(0)
  /// Largest manual discount, as a percentage of the subtotal, a cashier may give at the
  /// register without the owner's or a discount manager's approval.
  posMaxDiscountPercent Decimal  @default(20) @db.Decimal(5, 2)

  /// Plan the store last paid for. It only ever changes from a verified Stripe webhook
  /// (modules/billing/billing.webhook.ts), never from a client request or AI output. What the
  /// store may actually use right now is the *effective* plan (lib/plans.ts effectiveTier):
  /// a paid plan whose paid period, plus a short grace, has passed counts as FREE.
  plan                  PlanTier  @default(FREE)
  /// End of the paid period, from Stripe. Null on FREE.
  planExpiresAt         DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  /// One-off AI top-up packs: credits spent only after the month's plan allowance runs out.
  aiTopUpGenerations    Int       @default(0)
  aiTopUpChatMessages   Int       @default(0)
  /// A domain the store is served on (Business plan feature). Stored and unique; routing by
  /// domain is not built yet.
  customDomain          String?   @unique
  /// Weekly growth tips on the dashboard (Part C). The owner can switch them off.
  growthTipsEnabled     Boolean   @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  aiTopUpPurchases AiTopUpPurchase[]
  monthlyUsage     TenantMonthlyUsage[]
  growthTips       GrowthTip[]
  paymentSettings  PaymentSettings?
  codAssessments   CodAssessment[]
  paymentProofs    PaymentProof[]
  remittanceRuns   CodRemittanceRun[]
  remittanceItems  CodRemittanceItem[]
  voiceNotes       VoiceNote[]
  bargainSessions  BargainSession[]
  posShifts        PosShift[]
  orderReturns     OrderReturn[]
  heldSales        HeldSale[]
  owner            User                @relation("TenantOwner", fields: [ownerId], references: [id])
  staffMembers     StaffMember[]
  locations        Location[]
  inventoryLevels  InventoryLevel[]
  stockMovements   StockMovement[]
  customers        Customer[]
  checkoutSessions CheckoutSession[]
  refunds          Refund[]
  orders           Order[]
  payments         Payment[]
  shipments        Shipment[]
  shippingZones    ShippingZone[]
  discountCodes    DiscountCode[]
  aiUsageQuotas    AiUsageQuota[]
  cartRecoveryLogs CartRecoveryEvent[]
  aiBusinessInsight AiBusinessInsight?

  @@index([ownerId])
}

/// Staff account with restricted permissions, per Section 6/7.2 role-based access.
/// The tenant owner is NOT a StaffMember row; ownership is Tenant.ownerId.
model StaffMember {
  id          String            @id @default(cuid())
  tenantId    String
  userId      String
  permissions StaffPermission[]
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// COMMERCE CORE: LOCATIONS, INVENTORY, CUSTOMERS
// Shared by both sales channels (ONLINE and POS). Inventory lives here, in
// Postgres, so stock deduction is atomic with order creation.
// ──────────────────────────────────────────────────────────────────────────

/// A physical or logical place that holds stock and fulfils sales (a shop, a warehouse).
/// Every tenant gets one default location at registration, so the model supports multiple
/// stores/warehouses/terminals later without changing inventory or order keys.
model Location {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  orders          Order[]
  posShifts       PosShift[]

  @@index([tenantId])
}

/// Current on-hand quantity of one product at one location. The single source of truth
/// for stock, replacing the old Product.stock field in MongoDB. productId is a Mongo
/// ObjectId string (catalog lives in MongoDB), so there is no Postgres FK for it.
/// A CHECK (quantity >= 0) constraint is added in the migration SQL as a last line of
/// defense against overselling.
model InventoryLevel {
  id                String   @id @default(cuid())
  tenantId          String
  locationId        String
  productId         String
  quantity          Int      @default(0)
  lowStockThreshold Int?
  updatedAt         DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId, productId])
}

/// Append-only ledger of every stock change. Makes audits, returns, and later AI demand
/// forecasting possible; InventoryLevel.quantity is always the sum of these rows.
model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  locationId      String
  productId       String
  type            StockMovementType
  quantityChange  Int
  quantityAfter   Int
  orderId         String?
  note            String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@index([orderId])
}

/// A buyer as known to one business. Tenant-scoped so each business sees only its own
/// customers. POS walk-ins can exist without an account (userId null); an online shopper
/// with a ZYRO account is linked through userId.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// The priced cart, frozen at the moment a Stripe Checkout Session is created. The webhook
/// builds the order from this snapshot, so the order always matches what the shopper was
/// actually charged even if catalog prices or tax settings change in the meantime. It also
/// makes the webhook idempotent: only a PENDING record can be fulfilled, exactly once.
model CheckoutSession {
  id              String                @id @default(cuid())
  tenantId        String
  stripeSessionId String?               @unique
  status          CheckoutSessionStatus @default(PENDING)
  /// userId of a logged-in shopper; null for guests.
  userId          String?
  /// Redis cart key to clear once the order exists.
  cartKey         String
  /// Lines, totals, shipping and currency exactly as sent to Stripe.
  snapshot        Json
  totalCents      Int
  currency        String
  orderId         String?
  /// The discount code this checkout will redeem. While the session is PENDING and not yet
  /// expired it holds one of the code's uses, so a limited code cannot be overshot.
  discountCodeId  String?
  failureReason   String?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([discountCodeId, status, expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// ORDERS, PAYMENTS, SHIPPING
// ──────────────────────────────────────────────────────────────────────────

/// One order model for both channels. Order line items reference the MongoDB Product by id
/// (string), not a Postgres FK, since the catalog lives in a different database.
/// Title/price are snapshotted at order time so historical orders stay accurate even if
/// the product is later edited or deleted.
model Order {
  id                      String       @id @default(cuid())
  tenantId                String
  /// Human-readable per-tenant number shown on receipts and order lists.
  orderNumber             Int
  channel                 SalesChannel @default(ONLINE)
  locationId              String?
  /// The staff member (or owner) who rang up a POS sale; null for online orders.
  cashierUserId           String?
  customerId              String?
  guestEmail              String?
  status                  OrderStatus  @default(PENDING)
  subtotal                Decimal      @db.Decimal(10, 2)
  discountAmount          Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount               Decimal      @default(0) @db.Decimal(10, 2)
  shippingAmount          Decimal      @default(0) @db.Decimal(10, 2)
  total                   Decimal      @db.Decimal(10, 2)
  currency                String       @default("USD")
  discountCodeId          String?
  /// POS only: why a manual discount was given.
  discountReason          String?
  /// POS only: the register shift the sale was rung up in (drawer accounting).
  shiftId                 String?
  /// POS only: a key the register generates per sale attempt, so a retried or double
  /// submitted "Charge" returns the same order instead of creating a second one.
  clientRequestId         String?
  /// Where an online order ships, collected by Stripe Checkout: name and a normalized
  /// { line1, line2, city, state, postalCode, country } object. Null for POS orders.
  shippingName            String?
  shippingAddress         Json?
  stripeCheckoutSessionId String?      @unique
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id])
  cashier      User?         @relation("OrderCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  returns      OrderReturn[]
  shift        PosShift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shipment     Shipment?
  codAssessment   CodAssessment?
  paymentProofs   PaymentProof[]
  remittanceItems CodRemittanceItem[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, channel, createdAt])
  @@index([customerId])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String // Mongo ObjectId string: catalog lives in MongoDB
  productTitleSnapshot String
  unitPrice            Decimal  @db.Decimal(10, 2)
  /// Cost price at order time, when the merchant recorded one; enables margin analytics.
  unitCostSnapshot     Decimal? @db.Decimal(10, 2)
  quantity             Int
  /// How many units have come back through item returns; never more than `quantity`.
  returnedQuantity     Int      @default(0)
  lineTotal            Decimal  @db.Decimal(10, 2)

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems OrderReturnItem[]

  @@index([orderId])
}

/// One row per payment taken against an order (an order can be paid by several methods).
/// For Stripe payments this is the source of truth for "did payment succeed", written from
/// the webhook handler, never from the client redirect. Cash and card-terminal payments
/// at the POS are recorded directly with no Stripe id.
model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  orderId               String
  method                PaymentMethod @default(STRIPE)
  stripePaymentIntentId String?       @unique
  /// What was applied to the order. For cash this excludes the change handed back.
  amount                Decimal       @db.Decimal(10, 2)
  /// Cash only: what the customer handed over; change due is tendered minus amount.
  tenderedAmount        Decimal?      @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund Refund?

  @@index([tenantId])
  @@index([orderId])
}

/// Money returned for one payment, whatever its method. Stripe payments are refunded
/// through the Stripe API; cash, card-terminal and other payments are recorded here when
/// the merchant hands the money back. One refund per payment (unique), so a payment can
/// never be refunded twice. Full-order refunds only for now; partial refunds arrive with
/// line-item returns in the POS phase.
model Refund {
  id              String        @id @default(cuid())
  tenantId        String
  orderId         String
  paymentId       String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String
  method          PaymentMethod
  stripeRefundId  String?
  reason          String?
  restocked       Boolean       @default(false)
  createdByUserId String?
  /// The open register shift when cash or card was handed back, so the drawer balances.
  shiftId         String?
  createdAt       DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([shiftId])
}

// ──────────────────────────────────────────────────────────────────────────
// POINT OF SALE
// ──────────────────────────────────────────────────────────────────────────

/// One period of trading at a register, from opening the drawer with a float to counting
/// it at close. A location has at most one OPEN shift (a partial unique index in the
/// migration enforces it), which is how "one register per store" is kept true under
/// concurrent requests. Expected cash is computed and frozen when the shift closes.
model PosShift {
  id             String      @id @default(cuid())
  tenantId       String
  locationId     String
  status         ShiftStatus @default(OPEN)
  openedByUserId String
  closedByUserId String?
  openingFloat   Decimal     @db.Decimal(10, 2)
  /// Frozen at close: float + cash sales - cash paid back on returns.
  expectedCash   Decimal?    @db.Decimal(10, 2)
  countedCash    Decimal?    @db.Decimal(10, 2)
  /// counted minus expected; negative means the drawer is short.
  variance       Decimal?    @db.Decimal(10, 2)
  note           String?
  openedAt       DateTime    @default(now())
  closedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
}

/// Items taken back from one POS sale (partial or full), with the money returned. A sale
/// can have several returns until every unit has come back.
model OrderReturn {
  id              String        @id @default(cuid())
  tenantId        String
  orderId         String
  shiftId         String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String
  /// How the customer was paid back (cash, card terminal or other).
  method          PaymentMethod
  reason          String?
  restocked       Boolean       @default(true)
  createdByUserId String?
  createdAt       DateTime      @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  OrderReturnItem[]

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@index([shiftId])
}

model OrderReturnItem {
  id                   String  @id @default(cuid())
  returnId             String
  orderItemId          String
  productId            String
  productTitleSnapshot String
  quantity             Int
  amount               Decimal @db.Decimal(10, 2)

  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// A sale a cashier parked to serve someone else first. Only the cart is stored, never a
/// price, so resuming it always prices from the live catalog. No stock is reserved.
model HeldSale {
  id            String   @id @default(cuid())
  tenantId      String
  cashierUserId String
  label         String?
  customerId    String?
  /// [{ productId, quantity }]
  items         Json
  /// { type: "percentage" | "fixed", value, reason? } or null
  discount      Json?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Shipment {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String         @unique
  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Flat-rate shipping cost per region, per Section 6 ("configuring shipping rates").
/// No live carrier API integration: out of scope per Section 8 (LI-4 context).
model ShippingZone {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  region     String
  rateAmount Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// MARKETING
// ──────────────────────────────────────────────────────────────────────────

/// Codes are unique per store, not globally; two different merchants can both run "SALE20".
model DiscountCode {
  id          String       @id @default(cuid())
  tenantId    String
  code        String
  type        DiscountType
  /// A percentage (0 to 100) or an amount in the store's currency, depending on `type`.
  value       Decimal      @db.Decimal(10, 2)
  /// The smallest subtotal (before discount and tax) the code applies to; null for any.
  minSubtotal Decimal?     @db.Decimal(10, 2)
  expiresAt   DateTime?
  /// Null means unlimited. Counted when an order is written; pending online checkouts
  /// count against it until they finish or lapse, so it cannot be overshot.
  usageLimit  Int?
  usageCount  Int          @default(0)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders           Order[]
  checkoutSessions CheckoutSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// AI USAGE
// ──────────────────────────────────────────────────────────────────────────

/// One row per tenant per calendar month. Checked before enqueueing any AI job
/// (Implementation_Plan.md, Phase 4); incremented only on a successful generation/chat call.
model AiUsageQuota {
  id                String   @id @default(cuid())
  tenantId          String
  month             String // "YYYY-MM"
  generationsUsed   Int      @default(0)
  chatMessagesUsed  Int      @default(0)
  generationsLimit  Int
  chatMessagesLimit Int
  /// Tokens used by successful calls this month (Part B): what the store's AI actually cost.
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  /// Requests answered from the AI cache: no AI call, no quota, no cost.
  cachedAnswers     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
}

/// A store's running totals for one calendar month (UTC), kept up to date at write time (Part B):
/// createOrder, whole-order refunds and item returns update it in the same transaction as the row
/// they write, so it can never disagree with the orders table. The definitions match analytics:
/// every order counts once (orders are only ever created paid), at its total; refunds and returns
/// count in the month they are paid back. Read by the platform view and the Growth Advisor
/// instead of adding up orders every time.
model TenantMonthlyUsage {
  id           String   @id @default(cuid())
  tenantId     String
  month        String // "YYYY-MM", UTC
  onlineOrders Int      @default(0)
  posOrders    Int      @default(0)
  grossSales   Decimal  @default(0) @db.Decimal(14, 2)
  refundCount  Int      @default(0)
  refundTotal  Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt    DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([month])
}

/// One weekly Growth Advisor tip (Part C). At most one per store per week (the unique key). `rules`
/// are the checks that fired with the figures that fired them; `message` is what the merchant reads,
/// written by the AI from those figures (`source: ai`) or, when the AI is not available, from a
/// template (`source: template`). The AI cost is the platform's, recorded here, never the store's quota.
model GrowthTip {
  id           String    @id @default(cuid())
  tenantId     String
  /// Monday of the week (UTC), "YYYY-MM-DD".
  weekStart    String
  rules        Json
  message      String
  source       String
  model        String?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  dismissedAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekStart])
  @@index([tenantId, createdAt])
}

/// Part D, the Trend Scout: one weekly report per market and category, shared by every store that
/// sells in that category. Platform data, not any store's own, so there is no tenantId: what goes in
/// is anonymised first (a category needs enough stores, and no store may dominate it).
model TrendReport {
  id           String   @id @default(cuid())
  /// The market is the store currency (PKR, GBP...): trends in one country say little about another,
  /// and sales in different currencies cannot be added up.
  market       String
  /// Normalised category name ("home and kitchen"), as trends.service.ts's normaliseCategory makes it.
  category     String
  /// Monday of the week the report was written for (UTC), "YYYY-MM-DD"; it covers the 7 days before.
  weekStart    String
  /// "published", "no_data" (nothing to report) or "suppressed" (too few stores, or one store dominates).
  status       String
  /// The numbered facts the report was written from, each with its source and date. Every line of the
  /// report cites these by id, so it can be traced back line by line.
  facts        Json
  /// The report: [{ text, cites: ["F1", ...] }]. Empty unless published.
  lines        Json
  /// "ai" when the AI wrote it and every line passed the checks; "template" otherwise; "none" when not published.
  source       String
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// How many distinct stores' sales went into it (never shown exactly to merchants; see trends.service.ts).
  storeCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([market, category, weekStart])
  @@index([market, weekStart])
}

/// An external trends file imported by a platform administrator (Part D). The first source is a CSV
/// downloaded from trends.google.com (Google Trends has no self-serve API); others can be added behind
/// the same adapter (modules/trends/trends.sources.ts). The newest import per market and category is used.
model TrendSignalImport {
  id           String   @id @default(cuid())
  /// Which adapter reads it, e.g. "google_trends_csv".
  source       String
  market       String
  category     String
  /// The region the data describes, as the file names it ("Pakistan").
  geo          String
  /// [{ term, points: [{ date: "YYYY-MM-DD", value }] }], values 0 to 100 as Google Trends gives them.
  series       Json
  /// The last date the file covers, "YYYY-MM-DD".
  periodEnd    String
  fileName     String?
  importedById String
  createdAt    DateTime @default(now())

  @@index([market, category, createdAt])
}

/// One paid AI top-up pack. The unique Stripe session id is what makes crediting idempotent:
/// Stripe can deliver the same webhook twice, and the second insert fails instead of crediting again.
model AiTopUpPurchase {
  id              String   @id @default(cuid())
  tenantId        String
  packId          String
  generations     Int
  chatMessages    Int
  amountCents     Int
  currency        String
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Outcome tracking for AI-personalized abandoned-cart messages (Phase 5, Module 7 remainder).
/// cartId refers to the Redis cart key at send time; carts themselves are not persisted here.
model CartRecoveryEvent {
  id             String             @id @default(cuid())
  tenantId       String
  cartId         String
  customerEmail  String
  status         CartRecoveryStatus @default(SENT)
  discountCodeId String?
  sentAt         DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

/// The one cached AI business-insights write-up for a store (Implementation_Plan.md Phase 5:
/// "AI business insights"), generated on demand from real, computed facts (never invented by
/// the AI) - `facts` is a snapshot of exactly what was fed to the prompt, kept for the
/// merchant's own trust/debugging, not re-parsed by the app. One row per tenant (generating
/// again replaces it); staleness is judged by `generatedAt`, not stored here.
model AiBusinessInsight {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  text        String
  model       String
  facts       Json
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── Part E: payment and trust ───────────────────────────────────────────────────────────────

/// Which ways a store lets shoppers pay, and the limits on them (Part E). One row per store,
/// created on demand with safe defaults: card only, everything else off until the merchant turns
/// it on and fills in what it needs.
model PaymentSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  /// Cash on delivery. Off until the merchant turns it on.
  codEnabled     Boolean  @default(false)
  /// Smallest and largest order that may be paid cash on delivery, in the store currency. Null means no limit.
  codMinAmount   Decimal? @db.Decimal(10, 2)
  codMaxAmount   Decimal? @db.Decimal(10, 2)
  /// Above this risk band COD is not offered at checkout: "none" offers it to everyone,
  /// "high" hides it only from high-risk orders, "medium" from medium and high.
  codBlockBand   String   @default("high")
  /// A deposit asked for before a risky COD order is accepted, as a percentage of the total (0 = none).
  codAdvancePercent Int   @default(0)

  /// Manual bank or wallet transfer, with a screenshot the merchant checks.
  bankTransferEnabled Boolean @default(false)
  /// Shown to the shopper so they know where to send the money. No secrets: these are details a
  /// merchant hands out anyway. Never an API credential.
  bankAccountName     String?
  bankAccountNumber   String?
  bankName            String?
  bankInstructions    String?

  /// A local gateway through the adapter (modules/payments/gateways). Null means none chosen.
  gatewayProvider String?
  gatewayEnabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// What the COD Trust Agent decided about one order, kept so a merchant can always see why
/// (Part E). The score is produced by plain rules (modules/payments/cod.risk.ts), never by the AI:
/// `reasons` holds every rule that fired with its points, so the band can be explained line by line.
model CodAssessment {
  id       String  @id @default(cuid())
  tenantId String
  /// The order this is about, once it exists. An assessment is also made at checkout, before an order.
  orderId  String? @unique
  /// 0 (no concerns) to 100. Bands: under 35 low, 35 to 64 medium, 65 and over high.
  score    Int
  band     String
  /// [{ code, points, detail }] - one entry per rule that fired, in the order they were applied.
  reasons  Json
  /// The inputs the rules were allowed to see, kept so an assessment can be recomputed and checked.
  inputs   Json
  /// What the store did with it: "allowed", "blocked" (COD not offered) or "advance_required".
  outcome  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// A COD delivery history signal shared across the platform (Part E). Holds a one-way hash of the
/// shopper's phone number and nothing else that identifies anyone: no store, no order, no name, no
/// readable phone number. Stores learn only "this number has refused deliveries before", never where.
model CodPhoneSignal {
  id        String   @id @default(cuid())
  /// SHA-256 of the normalised phone number with a server-side pepper. Not reversible to a number.
  phoneHash String   @unique
  delivered Int      @default(0)
  refused   Int      @default(0)
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
}

/// A shopper's proof that they transferred the money themselves (Part E). The AI reads the image
/// and reports what it saw; the server compares that with the order and runs its own checks; the
/// merchant accepts or rejects. The AI never accepts a payment.
model PaymentProof {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  /// The uploaded screenshot.
  imageUrl String
  /// What the shopper typed in themselves.
  declaredAmount    Decimal @db.Decimal(10, 2)
  declaredReference String?
  /// What the AI read from the image: { amount, currency, date, reference, bank, sender, readable }.
  /// Null when the AI could not be reached; the merchant then checks the image unaided.
  extracted Json?
  /// [{ code, severity, detail }] - the server's own checks (amount matches, reference reused, ...).
  findings  Json
  /// "pending" until a human decides, then "accepted" or "rejected". Only a merchant moves it.
  status    String  @default("pending")
  /// Set when a merchant decides, never by the AI.
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  model            String?
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// The same transfer reference may be used once per store: a screenshot cannot be sent twice.
  @@unique([tenantId, declaredReference])
  @@index([tenantId, status])
  @@index([orderId])
}

/// One import of a courier's cash-collected file, reconciled against the store's COD orders (Part E).
model CodRemittanceRun {
  id       String @id @default(cuid())
  tenantId String
  /// Which courier's file this is, as the merchant named it ("TCS", "Leopards").
  courier  String
  fileName String?
  /// Totals, so a run can be summarised without reading every row.
  rowCount     Int @default(0)
  matchedCount Int @default(0)
  problemCount Int @default(0)
  /// The money the file says was collected, and the money the matched orders expected.
  fileTotal    Decimal @default(0) @db.Decimal(12, 2)
  matchedTotal Decimal @default(0) @db.Decimal(12, 2)
  importedByUserId String
  createdAt DateTime @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CodRemittanceItem[]

  @@index([tenantId, createdAt])
}

/// One line of a courier file, and what reconciling it found (Part E).
model CodRemittanceItem {
  id       String @id @default(cuid())
  runId    String
  tenantId String
  /// The order number as the courier's file gives it, and the amount it says was collected.
  reference String
  amount    Decimal @db.Decimal(10, 2)
  /// The order it was matched to, when one was found.
  orderId   String?
  /// "matched", "amount_mismatch", "unknown_order", "duplicate_in_file" or "not_cod".
  status    String
  detail    String?

  run    CodRemittanceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([tenantId, status])
}

// ── Part G: voice notes and bargaining ──────────────────────────────────────────────────────

/// A merchant's spoken instruction, turned into a draft the merchant must confirm (Part G).
/// Nothing here ever changes the catalogue on its own: `draft` is a proposal, and only an explicit
/// confirm applies it. The audio is transcribed by the Python service, never by Anthropic, which
/// does not accept audio at all.
model VoiceNote {
  id       String @id @default(cuid())
  tenantId String
  /// The merchant or staff member who recorded it.
  userId   String
  audioUrl String
  /// What the transcriber heard, and the language it detected ("ur", "en", ...).
  transcript String
  language   String?
  /// The proposed action: { kind, productId?, title?, price?, stock?, confidence, unclear? }.
  /// Null when nothing could be made of the words.
  draft      Json?
  /// Why no draft could be made, in words for the merchant.
  problem    String?
  /// "pending" until the merchant decides, then "applied" or "discarded".
  status     String  @default("pending")
  appliedAt  DateTime?
  model      String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// One haggling conversation over one product (Part G, "bhao-taao").
///
/// The floor price is copied here when the session opens and is never sent to the AI. The assistant
/// only ever chooses a move from a fixed list; this row holds the prices, and the server works out
/// every number from them. A session that ends in a deal gets a single-use discount code, which is
/// the only way the agreed price can actually be paid.
model BargainSession {
  id       String @id @default(cuid())
  tenantId String
  /// The product being haggled over (a MongoDB id).
  productId String
  /// Who is haggling: a signed-in shopper, or a guest session id.
  userId        String?
  guestSessionId String?
  /// Frozen when the session opens, so a price change mid-conversation cannot move the floor.
  listPrice  Decimal @db.Decimal(10, 2)
  floorPrice Decimal @db.Decimal(10, 2)
  /// The best price the shop has offered so far, and what the shopper last asked for.
  currentOffer  Decimal  @db.Decimal(10, 2)
  shopperOffer  Decimal? @db.Decimal(10, 2)
  /// How many times the shopper has pushed. Capped, so a conversation cannot grind the price down.
  rounds  Int    @default(0)
  /// "open", "agreed", "declined" or "expired".
  status  String @default("open")
  /// The single-use code created when a deal is struck; the only way to pay the agreed price.
  discountCodeId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, productId])
}
