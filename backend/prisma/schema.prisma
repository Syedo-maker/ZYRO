// ShopMind AI: PostgreSQL schema (Prisma)
// Phase 0, Module 1: Database schema design
// Entities per Implementation_Plan.md Section 1 (Relational store) and Phase 1/2/3/4/5 module specs.
//
// Multi-tenancy model: shared database, shared schema. Every tenant-scoped table carries
// a `tenantId` column. Isolation is enforced in two layers (see documentation/Phase0_Module1_Database_Schema_Design.md):
//   1. Prisma middleware (application layer): auto-injects tenantId on every query.
//   2. PostgreSQL Row-Level Security (database layer): see prisma/manual-sql/001_enable_rls.sql.
//      (Kept outside prisma/migrations/, since Prisma's migrate engine treats every subfolder
//      there as a real migration and errors on anything that isn't one.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────────────────────

enum StaffPermission {
  PRODUCTS_WRITE
  ORDERS_WRITE
  DISCOUNTS_WRITE
  ANALYTICS_READ
  POS_SELL
  INVENTORY_WRITE
  REFUNDS
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

/// Which sales channel created an order. Both channels share one order, inventory and
/// payment model; only the workflow in front of it differs.
enum SalesChannel {
  ONLINE
  POS
}

enum PaymentMethod {
  CASH
  CARD
  STRIPE
  OTHER
}

enum StockMovementType {
  INITIAL
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
}

enum CheckoutSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  REFUNDED
  FAILED
}

/// PAID: online order paid, awaiting fulfilment. COMPLETED: in-store sale, paid and handed over.
enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CartRecoveryStatus {
  SENT
  OPENED
  CLICKED
  CONVERTED
}

// ──────────────────────────────────────────────────────────────────────────
// IDENTITY & TENANCY
// ──────────────────────────────────────────────────────────────────────────

/// A single login-capable account. Covers both merchant owners/staff and customers:
/// a customer is simply a User with no Tenant ownership and no StaffMember rows.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownedTenants     Tenant[]       @relation("TenantOwner")
  staffMemberOf    StaffMember[]
  refreshTokens    RefreshToken[]
  customerProfiles Customer[]
  cashierOrders    Order[]        @relation("OrderCashier")

  @@index([email])
}

/// Server-side record of issued refresh tokens, keyed by a hash (never the raw token).
/// Without this, logout cannot actually revoke a token before its natural expiry; a
/// stateless JWT alone has no way to be invalidated early. Added during Phase 1 Module 1
/// implementation; not present in the original Module 1 schema pass.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A merchant's store. The tenant-isolation boundary for every scoped table below.
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  themeColor   String?
  ownerId      String
  currency     String   @default("USD")
  /// Percentage, e.g. 8.25 for 8.25%. Prices are treated as tax-exclusive.
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  /// Last order number issued for this tenant; incremented atomically inside createOrder.
  orderCounter Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner            User                @relation("TenantOwner", fields: [ownerId], references: [id])
  staffMembers     StaffMember[]
  locations        Location[]
  inventoryLevels  InventoryLevel[]
  stockMovements   StockMovement[]
  customers        Customer[]
  checkoutSessions CheckoutSession[]
  refunds          Refund[]
  orders           Order[]
  payments         Payment[]
  shipments        Shipment[]
  shippingZones    ShippingZone[]
  discountCodes    DiscountCode[]
  aiUsageQuotas    AiUsageQuota[]
  cartRecoveryLogs CartRecoveryEvent[]

  @@index([ownerId])
}

/// Staff account with restricted permissions, per Section 6/7.2 role-based access.
/// The tenant owner is NOT a StaffMember row; ownership is Tenant.ownerId.
model StaffMember {
  id          String            @id @default(cuid())
  tenantId    String
  userId      String
  permissions StaffPermission[]
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// COMMERCE CORE: LOCATIONS, INVENTORY, CUSTOMERS
// Shared by both sales channels (ONLINE and POS). Inventory lives here, in
// Postgres, so stock deduction is atomic with order creation.
// ──────────────────────────────────────────────────────────────────────────

/// A physical or logical place that holds stock and fulfils sales (a shop, a warehouse).
/// Every tenant gets one default location at registration, so the model supports multiple
/// stores/warehouses/terminals later without changing inventory or order keys.
model Location {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  orders          Order[]

  @@index([tenantId])
}

/// Current on-hand quantity of one product at one location. The single source of truth
/// for stock, replacing the old Product.stock field in MongoDB. productId is a Mongo
/// ObjectId string (catalog lives in MongoDB), so there is no Postgres FK for it.
/// A CHECK (quantity >= 0) constraint is added in the migration SQL as a last line of
/// defense against overselling.
model InventoryLevel {
  id                String   @id @default(cuid())
  tenantId          String
  locationId        String
  productId         String
  quantity          Int      @default(0)
  lowStockThreshold Int?
  updatedAt         DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, productId])
  @@index([tenantId, productId])
}

/// Append-only ledger of every stock change. Makes audits, returns, and later AI demand
/// forecasting possible; InventoryLevel.quantity is always the sum of these rows.
model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  locationId      String
  productId       String
  type            StockMovementType
  quantityChange  Int
  quantityAfter   Int
  orderId         String?
  note            String?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@index([orderId])
}

/// A buyer as known to one business. Tenant-scoped so each business sees only its own
/// customers. POS walk-ins can exist without an account (userId null); an online shopper
/// with a ZYRO account is linked through userId.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  name      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// The priced cart, frozen at the moment a Stripe Checkout Session is created. The webhook
/// builds the order from this snapshot, so the order always matches what the shopper was
/// actually charged even if catalog prices or tax settings change in the meantime. It also
/// makes the webhook idempotent: only a PENDING record can be fulfilled, exactly once.
model CheckoutSession {
  id              String                @id @default(cuid())
  tenantId        String
  stripeSessionId String?               @unique
  status          CheckoutSessionStatus @default(PENDING)
  /// userId of a logged-in shopper; null for guests.
  userId          String?
  /// Redis cart key to clear once the order exists.
  cartKey         String
  /// Lines, totals, shipping and currency exactly as sent to Stripe.
  snapshot        Json
  totalCents      Int
  currency        String
  orderId         String?
  failureReason   String?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// ORDERS, PAYMENTS, SHIPPING
// ──────────────────────────────────────────────────────────────────────────

/// One order model for both channels. Order line items reference the MongoDB Product by id
/// (string), not a Postgres FK, since the catalog lives in a different database.
/// Title/price are snapshotted at order time so historical orders stay accurate even if
/// the product is later edited or deleted.
model Order {
  id                      String       @id @default(cuid())
  tenantId                String
  /// Human-readable per-tenant number shown on receipts and order lists.
  orderNumber             Int
  channel                 SalesChannel @default(ONLINE)
  locationId              String?
  /// The staff member (or owner) who rang up a POS sale; null for online orders.
  cashierUserId           String?
  customerId              String?
  guestEmail              String?
  status                  OrderStatus  @default(PENDING)
  subtotal                Decimal      @db.Decimal(10, 2)
  discountAmount          Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount               Decimal      @default(0) @db.Decimal(10, 2)
  shippingAmount          Decimal      @default(0) @db.Decimal(10, 2)
  total                   Decimal      @db.Decimal(10, 2)
  currency                String       @default("USD")
  discountCodeId          String?
  /// Where an online order ships, collected by Stripe Checkout: name and a normalized
  /// { line1, line2, city, state, postalCode, country } object. Null for POS orders.
  shippingName            String?
  shippingAddress         Json?
  stripeCheckoutSessionId String?      @unique
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id])
  cashier      User?         @relation("OrderCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  shipment     Shipment?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, channel, createdAt])
  @@index([customerId])
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String // Mongo ObjectId string: catalog lives in MongoDB
  productTitleSnapshot String
  unitPrice            Decimal  @db.Decimal(10, 2)
  /// Cost price at order time, when the merchant recorded one; enables margin analytics.
  unitCostSnapshot     Decimal? @db.Decimal(10, 2)
  quantity             Int
  lineTotal            Decimal  @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// One row per payment taken against an order (an order can be paid by several methods).
/// For Stripe payments this is the source of truth for "did payment succeed", written from
/// the webhook handler, never from the client redirect. Cash and card-terminal payments
/// at the POS are recorded directly with no Stripe id.
model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  orderId               String
  method                PaymentMethod @default(STRIPE)
  stripePaymentIntentId String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund Refund?

  @@index([tenantId])
  @@index([orderId])
}

/// Money returned for one payment, whatever its method. Stripe payments are refunded
/// through the Stripe API; cash, card-terminal and other payments are recorded here when
/// the merchant hands the money back. One refund per payment (unique), so a payment can
/// never be refunded twice. Full-order refunds only for now; partial refunds arrive with
/// line-item returns in the POS phase.
model Refund {
  id              String        @id @default(cuid())
  tenantId        String
  orderId         String
  paymentId       String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String
  method          PaymentMethod
  stripeRefundId  String?
  reason          String?
  restocked       Boolean       @default(false)
  createdByUserId String?
  createdAt       DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
}

model Shipment {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String         @unique
  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Flat-rate shipping cost per region, per Section 6 ("configuring shipping rates").
/// No live carrier API integration: out of scope per Section 8 (LI-4 context).
model ShippingZone {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  region     String
  rateAmount Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// MARKETING
// ──────────────────────────────────────────────────────────────────────────

/// Codes are unique per store, not globally; two different merchants can both run "SALE20".
model DiscountCode {
  id         String       @id @default(cuid())
  tenantId   String
  code       String
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  expiresAt  DateTime?
  usageLimit Int?
  usageCount Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ──────────────────────────────────────────────────────────────────────────
// AI USAGE
// ──────────────────────────────────────────────────────────────────────────

/// One row per tenant per calendar month. Checked before enqueueing any AI job
/// (Implementation_Plan.md, Phase 4); incremented only on a successful generation/chat call.
model AiUsageQuota {
  id                String   @id @default(cuid())
  tenantId          String
  month             String // "YYYY-MM"
  generationsUsed   Int      @default(0)
  chatMessagesUsed  Int      @default(0)
  generationsLimit  Int
  chatMessagesLimit Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
}

/// Outcome tracking for AI-personalized abandoned-cart messages (Phase 5, Module 7 remainder).
/// cartId refers to the Redis cart key at send time; carts themselves are not persisted here.
model CartRecoveryEvent {
  id             String             @id @default(cuid())
  tenantId       String
  cartId         String
  customerEmail  String
  status         CartRecoveryStatus @default(SENT)
  discountCodeId String?
  sentAt         DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}
