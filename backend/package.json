{
    "name": "zyro-backend",
    "version": "0.1.0",
    "private": true,
    "description": "ZYRO backend API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:worker": "tsx watch src/worker.ts",
        "sync-indexes": "tsx scripts/sync-indexes.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --enable-source-maps dist/index.js",
        "start:worker": "node --enable-source-maps dist/worker.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "test": "jest",
        "test:real": "jest -c jest.real.config.js",
        "typecheck:tests": "tsc -p tsconfig.test.json"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.127.0",
        "@azure/identity": "^4.14.0",
        "@azure/monitor-opentelemetry": "^1.20.1",
        "@azure/storage-blob": "^12.34.0",
        "@prisma/client": "^6.1.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^6.3.8",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.3",
        "multer": "^2.0.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "rate-limit-redis": "^6.0.1",
        "stripe": "^22.6.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.2",
        "@types/supertest": "^7.2.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "jest": "^29.7.0",
        "js-yaml": "^5.4.2",
        "pino-pretty": "^13.2.0",
        "prisma": "^6.1.0",
        "supertest": "^7.3.0",
        "ts-jest": "^29.4.14",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "allowScripts": {
        "@prisma/client@6.19.3": true,
        "@prisma/engines@6.19.3": true,
        "esbuild@0.28.2": true,
        "prisma@6.19.3": true
    }
}
