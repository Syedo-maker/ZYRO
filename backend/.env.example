# Zyro backend: the API (npm run dev / npm start) and the worker (npm run dev:worker / npm run
# start:worker) read the same variables. Copy this file to backend/.env for local development.
# In staging and production, set real values in the platform's environment or secret store instead:
# variables already in the environment always win over this file, and no .env is shipped in images.
#
# Every setting is checked at startup (src/config/envCheck.ts). A missing or malformed one stops the
# process with a list of the variable NAMES and what they are for; values are never printed. Optional
# features that are off are listed in the startup log ("feature off: ...").
#
# Secrets may also be read from files: for any secret below, set NAME_FILE=/path/to/file instead of
# NAME (Docker and Kubernetes mount secrets this way).
#
# Legend:  [required]            the process will not start without it
#          [required in prod]    required when NODE_ENV=production (staging and production)
#          [optional]            has a safe default, or turns a feature off when missing (named)
#          [secret]              never commit, paste or log it
#
# Per-environment overrides: ../config/environments/*.env.example (development, test, staging, production).

# ---- Environment -----------------------------------------------------------------------------
# [optional] development | production. production turns on the strict checks, JSON logs, separate workers.
# NODE_ENV=development
# [optional] development | test | staging | production: a label for logs and error tracking.
#            Defaults to NODE_ENV's. Staging runs with NODE_ENV=production and APP_ENV=staging.
# APP_ENV=development

# ---- Databases and cache ---------------------------------------------------------------------
# [required][secret] PostgreSQL: stores, staff, orders, payments, plans. Everything stops without it.
#            Pool size per process: add &connection_limit=10 (and &pool_timeout=10) to the URL; the
#            default is 2 x CPUs + 1. Keep (instances x limit) below the server's max_connections.
DATABASE_URL="postgresql://zyro:zyro_dev_password@localhost:5432/zyro?schema=public"
# [required][secret] MongoDB: products, categories, reviews, AI content, chat transcripts.
MONGODB_URI="mongodb://localhost:27017/zyro"
# [optional] MongoDB connection pool per process (default 100).
# MONGO_MAX_POOL_SIZE=20
# [required in prod][secret] Redis: carts, rate limits, background job queues, caches. Default redis://127.0.0.1:6379.
REDIS_URL="redis://127.0.0.1:6379"
# [optional] Cart lifetime in Redis, seconds (default 7 days).
# CART_TTL_SECONDS=604800

# ---- Server and addresses --------------------------------------------------------------------
# [optional] API port (default 5000).
PORT=5000
# [required in prod] The web app's origin, the only one allowed to call the API with credentials.
CORS_ORIGIN="http://localhost:5173"
# [required in prod] The API's public address, used in links to uploaded files and in emails.
PUBLIC_URL="http://localhost:5000"
# [optional] Where shoppers land after an online payment (default CORS_ORIGIN).
# STOREFRONT_URL="http://localhost:5173"
# [optional] Number of reverse proxies in front of the API (0 = none), so rate limits and logs see
#            each visitor's real address. 1 behind one nginx or load balancer.
# TRUST_PROXY=0
# [optional] true redirects plain HTTP to https on PUBLIC_URL's host (off: the proxy usually does it).
# FORCE_HTTPS=false
# [optional] Largest JSON request body (default 100kb; uploads have their own 5 MB limit).
# REQUEST_BODY_LIMIT=100kb
# [optional] Countries a shopper may ship to (ISO codes).
# SHIPPING_COUNTRIES="US,CA,GB,AU,DE,FR,PK,AE"

# ---- Sign-in -----------------------------------------------------------------------------------
# [required][secret] Signs session tokens. Production refuses anything shorter than 32 characters or an
#            example value. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
# [optional] Access token lifetime (default 15m) and refresh token lifetime in days (default 7).
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="7"

# ---- File storage (src/lib/storage.ts) -------------------------------------------------------
# Product images are public; payment receipts and voice notes are private, handed out only as
# short-lived signed links.
# [optional] local (this machine's disk; development only) | azure (Blob Storage, or the Azurite
#            emulator). Production refuses local unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true.
# STORAGE_DRIVER="local"
# [optional] local driver folders (defaults uploads and uploads-private).
UPLOADS_DIR="uploads"
# PRIVATE_UPLOADS_DIR="uploads-private"
# [optional] How long a signed link to a private file works, seconds (default 3600).
# PRIVATE_FILE_LINK_SECONDS=3600
# [optional][secret] Signs the local driver's private links (derived from JWT_ACCESS_SECRET if unset).
# FILE_SIGNING_SECRET=""
# [required in prod with azure: one of these two][secret] Blob Storage access.
# AZURE_STORAGE_ACCOUNT_URL="https://<account>.blob.core.windows.net"   # with a managed identity
# AZURE_STORAGE_CONNECTION_STRING=""                                     # a key, or the Azurite emulator
# [optional] A user-assigned managed identity's client id; container names; and where browsers
#            fetch files when that is not the account itself (a CDN or custom domain).
# AZURE_CLIENT_ID=""
# AZURE_STORAGE_PUBLIC_CONTAINER="public"
# AZURE_STORAGE_PRIVATE_CONTAINER="private"
# AZURE_STORAGE_PUBLIC_URL=""
# [optional] true only on a host with a persistent disk.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# ---- Process lifecycle and workers -----------------------------------------------------------
# [optional] Background jobs (AI, cart recovery, weekly reports) run inside the API on a developer's
#            machine and in their own process in production (default: true unless NODE_ENV=production).
# RUN_WORKERS_IN_API=true
# [optional] The worker's health endpoint port (default 5001).
# WORKER_HEALTH_PORT=5001
# [optional] Each request is answered within this (503 otherwise); time to finish in-flight work
#            after SIGTERM; time each dependency gets in /ready. Milliseconds.
# REQUEST_TIMEOUT_MS=90000
# SHUTDOWN_GRACE_MS=25000
# READINESS_TIMEOUT_MS=2000
# [optional] BullMQ queue names, only to keep parallel test runs apart.
# AI_QUEUE_NAME, ADVISOR_QUEUE_NAME, CART_RECOVERY_QUEUE_NAME, TRENDS_QUEUE_NAME, PRODUCT_SCOUT_QUEUE_NAME

# ---- Logs and telemetry ----------------------------------------------------------------------
# [optional] fatal | error | warn | info | debug | trace | silent (default info).
# LOG_LEVEL=info
# [optional] json | pretty (default: json in production, pretty otherwise).
# LOG_FORMAT=json
# [optional][secret] Application Insights. Telemetry is off without it.
# APPLICATIONINSIGHTS_CONNECTION_STRING=""
# APPLICATIONINSIGHTS_SAMPLING_RATIO=1
# [optional] The process name in telemetry (zyro-api or zyro-worker).
# OTEL_SERVICE_NAME="zyro-api"
# [optional][secret] Error tracking (Sentry, GlitchTip or another Sentry-compatible service). Off without it.
#            Sends errors with request id, store id and path; never cookies, headers, bodies or IPs.
# SENTRY_DSN=""
# [optional] The release name errors are reported under (for example the git commit).
# APP_RELEASE=""

# ---- Abuse protection (counters live in Redis, shared by every instance) ---------------------
# [optional] false only for automated tests; production logs a warning if it is off.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_LOGIN_MAX=5            # failed logins per email and address per window
# RATE_LIMIT_LOGIN_IP_MAX=30        # failed logins per address, across all emails
# RATE_LIMIT_REGISTER_MAX=20        # registrations per address per hour
# RATE_LIMIT_REFRESH_MAX=600        # silent session refreshes per address per window
# RATE_LIMIT_API_MAX=600            # all API calls per address per minute
# RATE_LIMIT_DISCOUNT_MAX=20        # wrong discount codes per address per window
# RATE_LIMIT_REVIEW_MAX=10          # review writes per account per hour
# RATE_LIMIT_FORGOT_IP_MAX=5        # forgot-password requests per address per window
# RATE_LIMIT_FORGOT_EMAIL_MAX=3     # forgot-password requests per email per hour
# RATE_LIMIT_RESET_MAX=10           # reset-password attempts per address per window
# RATE_LIMIT_CHAT_MAX=10            # assistant messages per shopper per minute
# RATE_LIMIT_CHAT_IP_MAX=60         # assistant messages per address per minute
# RATE_LIMIT_HELP_MAX=20            # payment-failure help requests per address per hour
# RATE_LIMIT_THEME_AI_MAX=6         # Theme Studio design-assistant requests per person per minute
# RATE_LIMIT_THEME_AI_STORE_MAX=40  # Theme Studio design-assistant requests per store per hour
# RATE_LIMIT_PREFIX="rl:"           # Redis key prefix for the counters

# ---- Card payments and plan billing (Stripe) -------------------------------------------------
# [optional][secret] Without both, card checkout and plan billing answer 503 ("not set up");
#            cash on delivery and bank transfer keep working. Use test-mode keys (rk_test_... preferred).
#            See documentation/Stripe_Setup_And_Verification.md.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# [optional] A paid plan keeps working this many hours after its period ends (late renewal webhooks).
# PLAN_GRACE_HOURS=24
# [optional] The built-in test gateway, tests only; production logs a warning if it is on.
# GATEWAY_MOCK_ENABLED=false
# GATEWAY_MOCK_SECRET=""            # [secret] its callback signing secret

# ---- Cash on delivery --------------------------------------------------------------------------
# [optional][secret] Mixed into the shared cash-on-delivery phone hashes. Without it a public value is
#            used and production logs a warning: set a long random value in production.
# COD_PHONE_PEPPER=""

# ---- AI (src/modules/ai) -----------------------------------------------------------------------
# [optional][secret] Without a working key every AI feature (descriptions, tags, summaries, marketing,
#            the shopping assistant, the Theme Studio assistant, insights) answers "temporarily
#            unavailable" and uses no allowance; everything else works. Check keys without spending:
#            npm run ai:check
ANTHROPIC_API_KEY=""
# [optional][secret] Fallback provider, tried when the first one fails; and the order to try them.
# OPENAI_API_KEY=""
# AI_PROVIDER_ORDER="anthropic,openai"
# [optional] Models per tier (the plan prices in src/lib/plans.ts assume these; re-check if changed).
# AI_MODEL_FAST="claude-haiku-4-5"
# AI_MODEL_STANDARD="claude-sonnet-5"
# OPENAI_MODEL_FAST="gpt-4.1-mini"
# OPENAI_MODEL_STANDARD="gpt-4.1"
# [optional] Cost controls: prompt length cap (characters), answer cache (seconds, 0 = off), the Free
#            plan's monthly allowance, and how long a request waits for an AI job (milliseconds).
# AI_MAX_PROMPT_CHARS=16000
# AI_CACHE_SECONDS=86400
# AI_MONTHLY_GENERATIONS_LIMIT=15
# AI_MONTHLY_CHAT_MESSAGES_LIMIT=40
# AI_JOB_TIMEOUT_MS=60000
# [optional] AI answers one worker process handles at once (default 4). Throughput is about this
#            divided by the answer time; raise it within the AI account's rate limits.
# AI_WORKER_CONCURRENCY=4

# ---- Email (src/lib/email.ts) -------------------------------------------------------------------
# [optional] sendgrid (default) | brevo. Until the chosen provider's settings are all set, no email is
#            sent: cart-recovery reminders are not written (no AI spent) and password-reset links are
#            logged as "would have sent" in development only.
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=""               # [secret]
# SENDGRID_FROM_EMAIL=""            # a verified sender
# BREVO_API_KEY=""                  # [secret] (EMAIL_PROVIDER=brevo)
# BREVO_FROM_EMAIL=""               # a verified sender
# BREVO_FROM_NAME=""                # optional (default ZYRO)
# [optional] Cart recovery timing, hours.
# CART_RECOVERY_ABANDONED_AFTER_HOURS=2
# CART_RECOVERY_SCAN_INTERVAL_HOURS=1
# CART_RECOVERY_COOLDOWN_HOURS=24

# ---- Recommendation service (../recommendation-service) ---------------------------------------
# [optional][secret token] Without both, recommendations are empty and the shopping assistant matches
#            on keywords only. The token must equal the service's own RECOMMENDATION_SERVICE_TOKEN.
# RECOMMENDATION_SERVICE_URL="http://127.0.0.1:8001"
# RECOMMENDATION_SERVICE_TOKEN=""
# RECOMMENDATION_TIMEOUT_MS=4000
# RECOMMENDATION_CACHE_SECONDS=60

# ---- Platform trends and insights (privacy thresholds and tuning) -----------------------------
# [optional] Product Scout: a total is shown only when at least this many shops sold it (never below 2)
#            and no one shop (or the top two) had more than this share.
# SCOUT_MIN_STORES=3
# SCOUT_MAX_STORE_SHARE=0.6
# SCOUT_MAX_TOP_TWO_SHARE=0.85
# [optional] Trend Scout: fewest stores behind a figure, largest share one store may have.
# TREND_MIN_STORES=5
# TREND_MAX_STORE_SHARE=0.6
# [optional] Business insights thresholds.
# LOW_STOCK_FALLBACK_THRESHOLD=5
# INSIGHTS_VELOCITY_WINDOW_DAYS=14
# INSIGHTS_FORECAST_DAYS_THRESHOLD=7
# INSIGHTS_STALE_AFTER_HOURS=24

# ---- Development only ----------------------------------------------------------------------------
# [optional] The one demo store the public shop directory may list (walkthrough videos). Ignored in production.
# DIRECTORY_SHOWCASE_DEMO_SLUG=demo-scout-video-showcase
