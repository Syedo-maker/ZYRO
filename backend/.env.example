DATABASE_URL="postgresql://zyro:zyro_dev_password@localhost:5432/zyro?schema=public"
MONGODB_URI="mongodb://localhost:27017/zyro"

# Where uploaded product/branding images are stored (local disk, for this prototype -
# Implementation_Plan.md Phase 1 names S3-compatible object storage as the deferred
# alternative). PUBLIC_URL is prefixed onto served upload URLs.
UPLOADS_DIR="uploads"
PUBLIC_URL="http://localhost:5000"

# In production the server refuses to start unless this is a random string of at least 32
# characters (generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
# Refresh tokens are opaque random strings (hashed in the RefreshToken table), not JWTs -
# a JWT refresh token still needs a DB lookup to be revocable on logout, so there's no
# benefit to signing it; an opaque token is simpler and just as secure.
JWT_REFRESH_EXPIRES_IN_DAYS="7"

PORT=5000
CORS_ORIGIN="http://localhost:5173"

# Carts live in Redis (7-day TTL by default), keyed by store and shopper.
REDIS_URL="redis://127.0.0.1:6379"
# CART_TTL_SECONDS=604800

# Abuse protection (counters live in Redis). Defaults shown; set RATE_LIMIT_ENABLED=false only
# for automated tests. Set TRUST_PROXY to the number of reverse proxies in front of the API
# (for example 1 behind nginx or a load balancer) so limits apply per visitor, not per proxy.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_LOGIN_MAX=5          # failed logins per email and address per window
# RATE_LIMIT_LOGIN_IP_MAX=30      # failed logins per address, across all emails
# RATE_LIMIT_REGISTER_MAX=20      # registrations per address per hour
# RATE_LIMIT_REFRESH_MAX=600
# RATE_LIMIT_API_MAX=600          # all API calls per address per minute
# TRUST_PROXY=0

# Where shoppers land after Stripe Checkout (defaults to CORS_ORIGIN), and the countries
# Stripe may collect a shipping address for (comma-separated ISO codes).
# STOREFRONT_URL="http://localhost:5173"
# SHIPPING_COUNTRIES="US,CA,GB,AU,DE,FR,PK,AE"

# Stripe test-mode keys (create a sandbox with `npx --yes @stripe/cli sandbox create --email <you>`;
# see documentation/Stripe_Setup_And_Verification.md). Prefer a restricted key (rk_test_...) over a secret key. The
# webhook secret (whsec_...) comes from `stripe listen` locally or the Dashboard webhook
# endpoint. Checkout answers 503 until both are set.
# STRIPE_SECRET_KEY="rk_test_replace_me"
# STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# AI Orchestrator (Implementation_Plan.md Phase 4). Every AI feature (product descriptions,
# review summaries, auto-tagging, SEO metadata, the shopping assistant) answers 503 until this
# is set. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-replace_me"
# Cost control (Part A): each kind of request uses the cheapest model that does it well. "fast"
# answers short structured outputs and chat replies, "standard" writes descriptions, summaries,
# marketing copy, insights and recovery emails. AI_MODEL is the old name for the standard model.
# The plan prices in src/lib/plans.ts assume these two; change them and re-check the prices.
# AI_MODEL_FAST="claude-haiku-4-5"
# AI_MODEL_STANDARD="claude-sonnet-5"
# A prompt longer than this many characters is cut (about 4,000 tokens), so one call has a hard cost ceiling.
# AI_MAX_PROMPT_CHARS=16000
# Identical requests for a repeatable task (tags, SEO text, a review summary, insights) are answered
# from Redis for this many seconds, with no new AI call and no quota spent. 0 turns it off.
# AI_CACHE_SECONDS=86400
# The FREE plan's monthly allowance of AI generations / assistant chat messages. Pro and Business
# have their own in src/lib/plans.ts. A store that uses it up gets a 402 (with an upgrade hint).
# AI_MONTHLY_GENERATIONS_LIMIT=15
# AI_MONTHLY_CHAT_MESSAGES_LIMIT=40

# Plans and billing (Part A). Uses the Stripe keys above. A paid plan keeps working this many
# hours after its paid period ends, so a renewal webhook that arrives late does not drop the store
# to Free; after that it is Free. The Stripe key must be allowed to create Checkout Sessions,
# read Subscriptions and create Billing Portal sessions, and the webhook forwarder must include
# the subscription events (see documentation/Stripe_Setup_And_Verification.md).
# PLAN_GRACE_HOURS=24

# Abandoned-cart recovery (Implementation_Plan.md Phase 5, Module 7 remainder). A repeatable
# BullMQ job re-scans this often for carts inactive past the threshold, with no matching
# completed order, and emails a personalized reminder (via the AI orchestrator above) for each
# one it finds - once per cooldown window, never on every scan while it stays abandoned.
# CART_RECOVERY_ABANDONED_AFTER_HOURS=2
# CART_RECOVERY_SCAN_INTERVAL_HOURS=1
# CART_RECOVERY_COOLDOWN_HOURS=24

# Transactional email (recovery emails only, so far). The scan job runs and logs its would-be
# sends without a real send until both are set. Get a key at app.sendgrid.com; the from address
# must be a verified sender in that SendGrid account or it will reject every send.
# SENDGRID_API_KEY="SG.replace_me"
# SENDGRID_FROM_EMAIL="orders@yourstore.example"

# Recommendation microservice (Implementation_Plan.md Phase 6): the Python/FastAPI process in
# ../recommendation-service (see its README). Without both values the store works as before,
# recommendations come back empty, and the shopping assistant matches on keywords only. The
# token is a shared secret you make up (for example `openssl rand -hex 32`); the Python service
# must be started with the same value as RECOMMENDATION_SERVICE_TOKEN.
# RECOMMENDATION_SERVICE_URL="http://127.0.0.1:8001"
# RECOMMENDATION_SERVICE_TOKEN="replace-with-a-long-random-string"
# RECOMMENDATION_TIMEOUT_MS=4000
# RECOMMENDATION_CACHE_SECONDS=60

# AI business insights (Implementation_Plan.md Phase 5, the last item). Sales trend, best
# sellers and low-stock/demand-forecast facts are always computed for real; these only tune the
# low-stock/forecast thresholds and how long a generated write-up is served before it is
# reported stale. A product's own InventoryLevel.lowStockThreshold, when a merchant has set one,
# always wins over the fallback below.
# LOW_STOCK_FALLBACK_THRESHOLD=5
# INSIGHTS_VELOCITY_WINDOW_DAYS=14
# INSIGHTS_FORECAST_DAYS_THRESHOLD=7
# INSIGHTS_STALE_AFTER_HOURS=24
