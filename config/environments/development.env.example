# Development: a developer's machine. Start from backend/.env.example; these are its defaults.
NODE_ENV=development
APP_ENV=development
DATABASE_URL="postgresql://zyro:zyro_dev_password@localhost:5432/zyro?schema=public"
MONGODB_URI="mongodb://localhost:27017/zyro"
REDIS_URL="redis://127.0.0.1:6379"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_URL="http://localhost:5000"
STORAGE_DRIVER=local
# Workers run inside the API, logs are readable text, rate limits on. Paid services are optional:
# leave their keys empty and those features say "not set up" (or run scripts/e2e-server.ts for fakes).
