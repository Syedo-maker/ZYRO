# Production: real stores and shoppers. Set every value in the platform's secret store; nothing here
# is a real value. The backend refuses to start if a required one is missing or weak.
NODE_ENV=production
APP_ENV=production
DATABASE_URL=""                      # [secret]
MONGODB_URI=""                       # [secret]
REDIS_URL=""                         # [secret]
JWT_ACCESS_SECRET=""                 # [secret] 32+ random characters
CORS_ORIGIN="https://your-domain.example"
PUBLIC_URL="https://your-domain.example"
STOREFRONT_URL="https://your-domain.example"
TRUST_PROXY=1                        # the number of proxies in front of the API
RUN_WORKERS_IN_API=false
STORAGE_DRIVER=azure
AZURE_STORAGE_ACCOUNT_URL=""         # or AZURE_STORAGE_CONNECTION_STRING [secret]
COD_PHONE_PEPPER=""                  # [required][secret] set once, before the first order; never change it after
LOG_FORMAT=json
LOG_LEVEL=info
# Optional features: each stays off, with a startup log line, until its keys are set.
STRIPE_SECRET_KEY=""                 # [secret] live keys only here
STRIPE_WEBHOOK_SECRET=""             # [secret]
ANTHROPIC_API_KEY=""                 # [secret]
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=""                  # [secret]
SENDGRID_FROM_EMAIL=""
RECOMMENDATION_SERVICE_URL=""
RECOMMENDATION_SERVICE_TOKEN=""      # [secret]
APPLICATIONINSIGHTS_CONNECTION_STRING=""  # [secret] telemetry, optional
