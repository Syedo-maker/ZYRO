# Test: npm test in backend/ and the CI pipeline. Throwaway databases only; never a paid service
# (tests that call real Anthropic or Stripe live in backend/tests/real and need npm run test:real).
NODE_ENV=test
APP_ENV=test
DATABASE_URL="postgresql://zyro:ci-only@localhost:5432/zyro?schema=public"
MONGODB_URI="mongodb://localhost:27017/zyro"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="ci-only-not-a-real-secret-0123456789abcdef"
# Suites switch these themselves where they need to: rate limits off, fake AI and payment gateways.
# RATE_LIMIT_ENABLED=false
# AZURITE=1    # runs the Blob Storage suite against the Azurite emulator
