# Staging: production-like (the same strict checks and topology), with test-mode payment keys and
# throwaway data. compose.yaml at the repository root is a local version of this.
NODE_ENV=production
APP_ENV=staging
DATABASE_URL=""                      # [secret] a staging database, never production's
MONGODB_URI=""                       # [secret]
REDIS_URL=""                         # [secret] rediss:// where available
JWT_ACCESS_SECRET=""                 # [secret] 32+ random characters, different from production
CORS_ORIGIN="https://staging.example.com"
PUBLIC_URL="https://staging.example.com"
STOREFRONT_URL="https://staging.example.com"
TRUST_PROXY=1                        # the number of proxies in front of the API
RUN_WORKERS_IN_API=false             # the worker runs as its own process
STORAGE_DRIVER=azure                 # object storage; the API keeps nothing on its disk
AZURE_STORAGE_ACCOUNT_URL=""         # or AZURE_STORAGE_CONNECTION_STRING [secret]
COD_PHONE_PEPPER=""                  # [secret]
LOG_FORMAT=json
STRIPE_SECRET_KEY=""                 # [secret] TEST mode only on staging
STRIPE_WEBHOOK_SECRET=""             # [secret]
ANTHROPIC_API_KEY=""                 # [secret] optional; a separate key with its own spend limit
