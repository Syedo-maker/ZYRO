# The web container: serves the built site and forwards /api to the API, so the browser sees one
# origin. That is what lets the httpOnly, SameSite=lax login cookie work, exactly as the Vite dev
# server's proxy does locally. ${API_UPSTREAM} is filled in at start (nginx's template step), for
# example http://ca-zyro-prod-api on Azure or http://api:5000 in docker compose.
# Access log without query strings or the referer. A password-reset link carries its token in the
# query string, and the reset page's own asset requests carry that same URL as their referer, so the
# default log format wrote live reset tokens to the container log and on to Log Analytics (audit
# 2026-11). The backend already drops query strings from its own logs for the same reason.
map $request_uri $zyro_path {
    "~^(?<zyro_p>[^?]*)" $zyro_p;
    default "-";
}
# Link-preview apps (WhatsApp, Facebook, X, Telegram...) read a shared page without running its
# JavaScript, so they would only ever see index.html's generic card. On a /store/... address they are
# sent to the API's preview page instead, which has the shop's or product's own title, price and photo
# (backend/src/modules/seo). Search engines are not in this list: Google runs the app and reads the
# tags each page sets itself.
map $http_user_agent $zyro_preview_bot {
    default 0;
    "~*(facebookexternalhit|facebookcatalog|meta-externalagent|whatsapp|twitterbot|slackbot|telegrambot|linkedinbot|discordbot|pinterestbot|skypeuripreview|redditbot|embedly|viber)" 1;
}
log_format zyro_noquery '$remote_addr [$time_local] "$request_method $zyro_path $server_protocol" $status $body_bytes_sent "$http_user_agent"';

server {
    listen 8080;
    access_log /dev/stdout zyro_noquery;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # A voice note may be 10 MB; a little headroom for the form around it.
    client_max_body_size 12m;

    # Compress text: the app's JavaScript and CSS, and the API's JSON (gzip_proxied any covers the
    # proxied API answers). Images and fonts are already compressed formats and are left alone.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/problem+json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Each hop appends who it heard from; the API counts the hops (TRUST_PROXY) to find the visitor.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $http_x_request_id;
        # Longer than the API's own 90-second limit, so the API, which knows what went wrong,
        # always answers first.
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # robots.txt and the sitemap come from the API, which knows the shops (backend/src/modules/seo).
    location = /robots.txt {
        proxy_pass ${API_UPSTREAM}/api/v1/seo/robots.txt;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
    location = /sitemap.xml {
        proxy_pass ${API_UPSTREAM}/api/v1/seo/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # A shop or product page: the app for people, the preview page for link-preview apps (map above).
    location /store/ {
        if ($zyro_preview_bot) {
            rewrite ^ /api/v1/seo/preview?path=$uri? last;
        }
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # Built files carry a content hash in their names, so they never change: cache for a year.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything else is the single-page app; index.html is always revalidated so a release shows at once.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
